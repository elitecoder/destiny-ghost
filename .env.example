# Bungie app credentials — register at https://www.bungie.net/en/Application
#   OAuth Client Type: Confidential
#   Redirect URL:      https://127.0.0.1:7777/callback   (must match exactly)
#   Scopes:            Read Destiny inventory/vault + Move or equip Destiny gear
BUNGIE_API_KEY=your_api_key
BUNGIE_CLIENT_ID=your_oauth_client_id
BUNGIE_CLIENT_SECRET=your_oauth_client_secret

# Anthropic key for the agent loop (or use `ant auth login`)
ANTHROPIC_API_KEY=your_anthropic_key

# Optional overrides
# GHOST_MODEL=claude-opus-4-8
# PORT=8787
