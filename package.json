{
  "name": "destiny-ghost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An LLM-fronted Destiny 2 item manager — type what you want, Claude drives the Bungie API.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server/app.ts",
    "start": "tsx src/server/app.ts",
    "auth": "tsx src/bungie/auth-cli.ts",
    "manifest": "tsx src/bungie/manifest-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "bungie-api-ts": "^5.1.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
