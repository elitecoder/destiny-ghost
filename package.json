{
  "name": "destiny-ghost",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Talk-in-chat Destiny 2 item manager — an MCP server exposing the Bungie API to your LLM.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "auth": "tsx src/bungie/auth-cli.ts",
    "manifest": "tsx src/bungie/manifest-cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "vault-report": "tsx src/bungie/vault-report-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bungie-api-ts": "^5.1.0",
    "dotenv": "^16.4.5",
    "open": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
